# Ambiente
APP_ENV=development

# Banco de dados
# Use sqlite em ambiente local ou mysql em hospedagem
DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Link para pagina de recuperacao (opcional)
RECOVERY_PAGE_URL=

# SMTP (para envio de e-mail de recuperacao)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gestao de Atestados

# Expor token na resposta em desenvolvimento (0 ou 1)
EXPOSE_RESET_TOKEN=0
