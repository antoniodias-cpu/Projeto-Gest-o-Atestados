# Ambiente
NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-esta-chave

# Banco de dados
# Use sqlite em ambiente local ou mysql em hospedagem
DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Link para pagina de recuperacao (opcional)
# Se vazio, o servidor monta automaticamente com base no host atual.
RECOVERY_PAGE_URL=

# SMTP (obrigatorio para envio real por e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gestao de Atestados

# Em desenvolvimento, expor token na resposta para testes (0 ou 1)
EXPOSE_RESET_TOKEN=0
